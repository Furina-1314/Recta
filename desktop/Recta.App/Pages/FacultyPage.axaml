<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Recta.App.Controls"
             x:Class="Recta.App.Pages.FacultyPage">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="28,24,28,16">

        <StackPanel Spacing="2">
            <TextBlock Classes="page-title" Text="系报" Margin="0" />
            <TextBlock Classes="secondary"
                       Text="系级报销往来暂挂 —— 班委垫付挂账、系财务打款核销;生活委员存管,办结即增加应收挂账" />
        </StackPanel>

        <!-- 挂账余额 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,14">
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="secondary" Text="当前挂账(外部应收)" />
                    <TextBlock x:Name="HangingValue" Classes="money money-value" Text="—" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="secondary" Text="通道规则" />
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               Text="审批与办结均由生活委员唯一执行;系财务打款到账后在此核销平账,核销金额不得超过挂账余额,且必须关联已办结的系报销单据。" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 核销(仅生活委员) + 新提单 -->
        <StackPanel Grid.Row="2" Spacing="12" Margin="0,2,0,0">
            <Border x:Name="RedeemCard" Classes="card" IsVisible="False">
                <StackPanel Spacing="10">
                    <TextBlock Text="系财务打款核销" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,12,2*,12,2*,12,Auto">
                        <TextBox x:Name="RedeemAmountBox" Classes="money" TextAlignment="Right"
                                 Watermark="0.00" />
                        <TextBox Grid.Column="2" x:Name="RedeemSourceBox"
                                 Watermark="来源(如:系财务 9 月经费打款)" />
                        <ComboBox Grid.Column="4" x:Name="RelatedBox" MinWidth="180"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="6" Classes="accent" Content="确认核销" Click="OnRedeem" />
                    </Grid>
                    <TextBlock x:Name="RedeemError" Classes="danger-text" IsVisible="False" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <controls:NewRequestPanel x:Name="SubmitPanel" />
        </StackPanel>

        <!-- 本渠道单据 -->
        <Grid Grid.Row="3" RowDefinitions="Auto,8,*" Margin="0,12,0,0">
            <TextBlock Text="本渠道单据" FontWeight="SemiBold" />
            <controls:ChannelRequestList Grid.Row="2" x:Name="ChannelList" Category="FACULTY" />
        </Grid>
    </Grid>
</UserControl>
