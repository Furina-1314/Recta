<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Recta.App.Pages"
             x:Class="Recta.App.Pages.InflowPage">

    <Grid RowDefinitions="Auto,Auto,*" Margin="28,24,28,16">

        <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="2">
            <TextBlock Classes="page-title" Text="入账" Margin="0" />
            <TextBlock Classes="secondary"
                       Text="每一笔收入都有来龙去脉——灵活公款增资、系报销核销、同学充值补缴" />
        </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnRefresh" AutomationProperties.Name="刷新">
                    <TextBlock Text="&#xE72C;" Classes="icon" />
                </Button>
            </Grid>

        <!-- 充值补缴(生活委员) -->
        <Border Grid.Row="1" x:Name="RechargeCard" Classes="card" IsVisible="False" Margin="0,14,0,0">
            <StackPanel Spacing="10">
                <TextBlock Text="同学班费充值 / 补缴(仅生活委员)" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="220,12,140,12,2*,12,Auto,12,2*">
                    <ComboBox x:Name="StudentBox" HorizontalAlignment="Stretch" />
                    <TextBox Grid.Column="2" x:Name="AmountBox" Classes="money" TextAlignment="Right"
                             Watermark="0.00" />
                    <TextBox Grid.Column="4" x:Name="SourceBox" Watermark="来源(如:张三 9 月班费转账)" />
                    <Button Grid.Column="6" Classes="accent" Content="确认入账" Click="OnRecharge" />
                    <TextBlock Grid.Column="8" x:Name="RechargeError" Classes="danger-text"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 入账台账 -->
        <Border Grid.Row="2" Classes="card" Padding="0" Margin="0,12,0,0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource RectaPaneBrush}"
                        BorderBrush="{DynamicResource RectaDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="170,*,120,150,150,120">
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource RectaTextSecondaryBrush}" />
                            </Style>
                        </Grid.Styles>
                        <TextBlock Text="时间" Margin="14,8,8,8" />
                        <TextBlock Grid.Column="1" Text="来源凭据" Margin="8,8,8,8" />
                        <TextBlock Grid.Column="2" Text="金额(元)" Classes="money" Margin="8,8,14,8" />
                        <TextBlock Grid.Column="3" Text="去向" Margin="8,8,8,8" />
                        <TextBlock Grid.Column="4" Text="定向目标" Margin="8,8,8,8" />
                        <TextBlock Grid.Column="5" Text="经办人" Margin="8,8,8,8" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="Rows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:InflowRowVm">
                                <Border BorderBrush="{DynamicResource RectaDividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="164,*,120,150,150,120" MinHeight="40">
                                        <TextBlock Text="{Binding Time}" VerticalAlignment="Center" FontSize="12"
                                                   Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding AmountText}" Classes="money"
                                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding DestinationLabel}"
                                                   VerticalAlignment="Center" FontSize="13" Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding Target}" VerticalAlignment="Center"
                                                   FontSize="13" Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding OperatorName}"
                                                   VerticalAlignment="Center" FontSize="13" Margin="2,0,8,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
