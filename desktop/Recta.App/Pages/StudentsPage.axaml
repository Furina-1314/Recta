<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Recta.App.Pages"
             x:Class="Recta.App.Pages.StudentsPage">

    <Grid ColumnDefinitions="*,8,376" Margin="28,24,28,16">

        <!-- 左:名单与对账 -->
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="2">
                <TextBlock Classes="page-title" Text="分户" Margin="0" />
                <TextBlock Classes="secondary"
                           Text="每位同学的独立班费账户——余额为负表示暂由生活委员垫付,补缴后自动恢复" />
            </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnRefresh" AutomationProperties.Name="刷新">
                    <TextBlock Text="&#xE72C;" Classes="icon" />
                </Button>
            </Grid>

            <!-- 对账三元组 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,10,*,10,*,10,*" Margin="0,14">
                <Border Classes="card" Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" FontSize="12" Text="全班结余合计" />
                        <TextBlock x:Name="SumValue" Classes="money money-value" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" FontSize="12" Text="代管实存 C_cash" />
                        <TextBlock x:Name="CashValue" Classes="money money-value"
                                   Foreground="{DynamicResource RectaPositiveBrush}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card" Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" FontSize="12" Text="生委垫资 A_advance" />
                        <TextBlock x:Name="AdvanceValue" Classes="money money-value"
                                   Foreground="{DynamicResource RectaDangerBrush}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="card" Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" FontSize="12" Text="账目平衡校验" />
                        <TextBlock x:Name="ConservedValue" Classes="money money-value" Text="—" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 名单管理(团支书) -->
            <Border Grid.Row="2" x:Name="RosterCard" Classes="card" IsVisible="False" Margin="0,2,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="同学名单管理(仅团支书)" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,12,*,12,Auto,12,2*,12,Auto,12,Auto">
                        <TextBox x:Name="NewStudentIdBox" Watermark="学号" />
                        <TextBox Grid.Column="2" x:Name="NewStudentNameBox" Watermark="姓名" />
                        <Button Grid.Column="4" Classes="accent" Content="＋ 录入" Click="OnAddStudent" />
                        <TextBox Grid.Column="6" x:Name="RenameBox"
                                 Watermark="选中行后输入新姓名…" IsEnabled="False" />
                        <Button Grid.Column="8" x:Name="RenameButton" Content="改名" Click="OnRenameStudent"
                                IsEnabled="False" />
                        <TextBlock Grid.Column="10" x:Name="RosterError" Classes="danger-text"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 名单表 -->
            <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True" Margin="0,10,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{DynamicResource RectaPaneBrush}"
                            BorderBrush="{DynamicResource RectaDividerBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="120,*,140,140,140">
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource RectaTextSecondaryBrush}" />
                                </Style>
                            </Grid.Styles>
                            <TextBlock Text="学号" Margin="14,8,8,8" />
                            <TextBlock Grid.Column="1" Text="姓名" Margin="8,8,8,8" />
                            <TextBlock Grid.Column="2" Text="余额(元)" Classes="money" Margin="8,8,14,8" />
                            <TextBlock Grid.Column="3" Text="累计充值(元)" Classes="money" Margin="8,8,8,8" />
                            <TextBlock Grid.Column="4" Text="累计支出(元)" Classes="money" Margin="8,8,8,8" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <ListBox x:Name="Rows" Background="Transparent" Padding="0" SelectionMode="Single"
                                 SelectionChanged="OnRowSelected">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="6,0,0,0" />
                                    <Setter Property="MinHeight" Value="42" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:StudentRowVm">
                                    <Grid ColumnDefinitions="114,*,140,140,140" MinHeight="42">
                                        <TextBlock Text="{Binding StudentId}" VerticalAlignment="Center"
                                                   FontSize="13" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding BalanceText}" Classes="money"
                                                   Foreground="{Binding BalanceBrush}" VerticalAlignment="Center"
                                                   Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding RechargedText}" Classes="money"
                                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding SpentText}" Classes="money"
                                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" x:Name="SummaryText" Classes="secondary" Margin="0,8,0,0" Text="—" />
        </Grid>

        <!-- 右:个人详情 + 流水 + 垫资披露 -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
            <Border Classes="card" Padding="20,14">
                <StackPanel Spacing="8">
                    <TextBlock Text="个人分户详情" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" Classes="secondary" TextWrapping="Wrap"
                               Text="在左侧选择同学查看详情与流水。" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,10,0,0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{DynamicResource RectaPaneBrush}" Padding="20,10"
                            BorderBrush="{DynamicResource RectaDividerBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="历史流水" FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="LedgerList" Margin="16,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LedgerLineVm">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="12"
                                                   Foreground="{Binding TypeBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="12"
                                                   Classes="secondary" TextTrimming="CharacterEllipsis"
                                                   Margin="10,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding ChangeText}" Classes="money" FontSize="13"
                                                       Foreground="{Binding TypeBrush}" />
                                            <TextBlock Text="{Binding BalanceText}" Classes="money" FontSize="13"
                                                       Width="86" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 垫资披露 -->
            <Border Grid.Row="2" Classes="card" Padding="20,12" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="垫资披露(当前透支同学)" FontWeight="SemiBold"
                               Foreground="{DynamicResource RectaDangerBrush}" />
                    <TextBlock x:Name="AdvanceDisclosure" FontSize="13" TextWrapping="Wrap" Text="—" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
