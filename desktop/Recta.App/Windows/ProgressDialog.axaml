<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Recta.App.Windows.ProgressDialog"
        Title="正在下载更新"
        Width="420" Height="170" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RectaCanvasBrush}" FontSize="14">

    <StackPanel Margin="24,20" Spacing="12">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="准备中…" />
        <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="1" Height="6" />
        <Button HorizontalAlignment="Right" MinWidth="96" Content="取消" Click="OnCancel" />
    </StackPanel>
</Window>
