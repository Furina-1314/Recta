<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Recta.App.Windows.TextInputDialog"
        Title="输入"
        Width="420" Height="220" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RectaCanvasBrush}" FontSize="14">

    <StackPanel Margin="24,20" Spacing="12">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" />
        <TextBlock x:Name="ErrorText" Classes="danger-text" IsVisible="False" />
        <Grid ColumnDefinitions="*,12,*">
            <Button Content="取消" Click="OnCancel" />
            <Button Grid.Column="2" Classes="accent" Content="确定" Click="OnConfirm" />
        </Grid>
    </StackPanel>
</Window>
