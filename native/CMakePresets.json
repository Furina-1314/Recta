{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-x64-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_MANIFEST_INSTALL": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "win-x64-debug",
      "inherits": "win-x64-base",
      "displayName": "Windows x64 Debug (vcpkg)",
      "binaryDir": "${sourceDir}/build/win-x64-debug"
    },
    {
      "name": "win-x64-release",
      "inherits": "win-x64-base",
      "displayName": "Windows x64 Release (vcpkg)",
      "binaryDir": "${sourceDir}/build/win-x64-release"
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
